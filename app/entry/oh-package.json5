{
  "name": "entry",
  "version": "1.0.0",
  "description": "ohos-tailscale 应用入口模块：UI（EntryAbility/pages）+ VPN 扩展（VpnExtensionAbility）",
  "main": "",
  "author": "ohos-tailscale contributors",
  "license": "BSD-3-Clause",
  "dependencies": {
    // CU6 方案 A 实测：file: 本地目录依赖直指仓库 packages/* 纯 TS 源码（noise/wireguard 及其
    // 内部依赖 common/crypto）。各包已加 oh-package.json5（main: src/index.ts），package.json 未动。
    "@ohos-tailscale/common": "file:../../packages/common",
    "@ohos-tailscale/crypto": "file:../../packages/crypto",
    "@ohos-tailscale/noise": "file:../../packages/noise",
    "@ohos-tailscale/wireguard": "file:../../packages/wireguard"
  }
}
